{
    "name": "elgentos/magento2-inventory-log",
    "description": "Magento 2 - Inventory Log",
    "type": "magento2-module",
    "license": [
        "OSL-3.0"
    ],
    "require": {
        "hyva-themes/module-magento2-admin": "*"
    },
    "minimum-stability": "dev",
    "authors": [
        {
            "name": "Kiwi Commerce Ltd",
            "email": "hello@kiwicommerce.co.uk",
            "homepage": "https://kiwicommerce.co.uk/",
            "role": "Original"
        },
	{
            "name": "elgentos",
            "email": "info@elgentos.nl",
            "homepage": "https://elgentos.nl/",
            "role": "Adoptee"
        }
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Elgentos\\InventoryLog\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
